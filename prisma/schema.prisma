// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes         Note[]
  tasks         Task[]
  habits        Habit[]
  transactions  Transaction[]
  accounts      Account[]
  snapTradeUser SnapTradeUser?

  @@map("users")
}

// ============================================
// FINANCE MODELS
// ============================================

model Account {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  name         String      // "Chase Checking", "Fidelity Brokerage"
  type         AccountType
  institution  String?     // "Chase", "Fidelity", "Robinhood"
  balance      Decimal     @default(0) @db.Decimal(12, 2)
  currency     String      @default("USD")
  color        String?     // Hex color for UI display
  isSnapTrade  Boolean     @default(false) @map("is_snaptrade")
  snapTradeId  String?     @unique @map("snaptrade_account_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  positions    Position[]

  @@index([userId])
  @@map("accounts")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  BROKERAGE
  RETIREMENT
  CRYPTO
  CASH
  OTHER
}

model Position {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  symbol       String   // "AAPL", "BTC"
  name         String   // "Apple Inc.", "Bitcoin"
  quantity     Decimal  @db.Decimal(18, 8)
  costBasis    Decimal  @db.Decimal(12, 2) @map("cost_basis")
  currentPrice Decimal  @db.Decimal(12, 2) @map("current_price")
  currency     String   @default("USD")
  lastUpdated  DateTime @default(now()) @map("last_updated")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([symbol])
  @@map("positions")
}

model SnapTradeUser {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  snapUserId String   @unique @map("snap_user_id")
  userSecret String   @map("user_secret")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("snaptrade_users")
}

model Note {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  content         String   @db.Text
  paraType        ParaType @map("para_type")
  tags            String[]
  linkedNoteIds   String[] @map("linked_note_ids")
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paraType])
  @@index([tags])
  @@map("notes")
}

enum ParaType {
  PROJECT
  AREA
  RESOURCE
  ARCHIVE
}

model Task {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  title         String
  description   String?    @db.Text
  status        TaskStatus @default(BACKLOG)
  dueDate       DateTime?  @map("due_date")
  tags          String[]
  category      String?
  linkedNoteId  String?    @map("linked_note_id")
  position      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("tasks")
}

enum TaskStatus {
  BACKLOG
  DOING
  DONE
}

model Habit {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  name      String
  frequency HabitFrequency  @default(DAILY)
  createdAt DateTime        @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
  @@map("habits")
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String   @map("habit_id")
  completedAt DateTime @default(now()) @map("completed_at")
  date        DateTime @db.Date

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@index([date])
  @@map("habit_logs")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  accountId   String?           @map("account_id")
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  category    String?           // Optional - allows uncategorized transactions
  description String?           @db.Text
  merchant    String?           // Store name, e.g. "Starbucks"
  tags        String[]
  receiptUrl  String?           @map("receipt_url")
  date        DateTime          @db.Date
  snapTradeId String?           @unique @map("snaptrade_transaction_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([type])
  @@index([category])
  @@index([date])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}
